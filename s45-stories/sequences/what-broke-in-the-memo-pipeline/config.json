      "blocks": [
        {
          "text": "Our memo pipeline produced a clean document that argued nothing."
        },
        {
          "text": "I shipped it. That was the mistake.",
          "size": "med",
          "highlights": [
            {
              "text": "That was the mistake",
              "style": "underline"
